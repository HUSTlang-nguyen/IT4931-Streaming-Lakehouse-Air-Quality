# Copy thành .env và điền API key local; không commit secrets.
# CLI start sinh credential dịch vụ còn trống, giữ giá trị đã có.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
AIR_QUALITY_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
AIR_QUALITY_BACKFILL_DAYS=180
AIR_QUALITY_POLL_INTERVAL_SECONDS=300
AIR_QUALITY_OVERLAP_HOURS=24
AIR_QUALITY_RECONCILE_DAYS=7
AIR_QUALITY_RECONCILE_INTERVAL_HOURS=24
AIR_QUALITY_INGEST_MODE=live
AIR_QUALITY_TOPIC=air-quality.live
AIR_QUALITY_STATE_DIR=checkpoints
AIR_QUALITY_DATA_DIR=data
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# Dưới 60/phút và 2.000/giờ; limiter SQLite chia sẻ giữa các lệnh.
OPENAQ_REQUEST_INTERVAL_SECONDS=2.1
OPENAQ_HOURLY_REQUEST_LIMIT=1800
OPENAQ_PAGE_SIZE=1000

# Để trống để start sinh credential local ngẫu nhiên.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
POSTGRES_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
